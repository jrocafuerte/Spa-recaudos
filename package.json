{
  "name": "spa-recaudos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "tokens": "node design-tokens/build.mjs --target=web --out=src/app/tokens.generated.css && prettier --write src/app/tokens.generated.css",
